---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'main'>

const { class: className, ...props } = Astro.props;
---

<main class:list={['x-main', className]} {...props}>
  <slot />
</main>

<style is:global>
  @layer theme, base, utilities;

  @layer utilities {
    .x-main {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
  }
</style>
