---
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }>

const { as: Tag = 'div', class: className, ...props } = Astro.props;
---

<Tag class:list={['x-marquee', className]} {...props}>
  <slot />
</Tag>

<style is:global>
  @layer theme, base, utilities;

  @import "winduum/src/components/marquee/default.css" layer(utilities);
  @import "winduum/src/components/marquee/keyframes/default.css";
</style>
