---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<'dialog'>;

const { class: className, ...props } = Astro.props;
---

<dialog is="x-drawer" class:list={["x-drawer", className]} {...props}>
    <slot />
</dialog>

<script>
    import { Drawer } from 'winduum-elements/components/drawer/index.js'

    customElements.define('x-drawer', class Element extends Drawer {}, { extends: 'dialog' })
</script>

<style is:global>
  @layer theme, base, utilities;

  @import "winduum/src/components/drawer/props/default.css" layer(theme);
  @import "winduum/src/components/drawer/props/content.css" layer(theme);
  @import "winduum/src/components/drawer/default.css" layer(utilities);
  @import "winduum/src/components/drawer/scroller.css" layer(utilities);
  @import "winduum/src/components/drawer/content.css" layer(utilities);
  @import "winduum/src/components/drawer/keyframes/default.css";

  @layer utilities {
    .x-drawer {
      --x-drawer-content-inline-size: min(calc(100vw - 2rem), 22rem);
      --x-drawer-content-block-size: 100dvh;
    }

    .x-drawer-content {
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
</style>
