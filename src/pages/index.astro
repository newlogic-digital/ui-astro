---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/(ui)/Badge.astro';
import Button from '../components/(ui)/Button.astro';
import Carousel from '../components/(ui)/Carousel.astro';
import Check from '../components/(ui)/Check.astro';
import Control from '../components/(ui)/Control.astro';
import Details from '../components/(ui)/Details.astro';
import Dialog from '../components/(ui)/Dialog.astro';
import Drawer from '../components/(ui)/Drawer.astro';
import Field from '../components/(ui)/Field.astro';
import Form from '../components/(ui)/Form.astro';
import Group from '../components/(ui)/Group.astro';
import Heading from '../components/(ui)/Heading.astro';
import Image from '../components/(ui)/Image.astro';
import Info from '../components/(ui)/Info.astro';
import Label from '../components/(ui)/Label.astro';
import Marquee from '../components/(ui)/Marquee.astro';
import Notice from '../components/(ui)/Notice.astro';
import Pagination from '../components/(ui)/Pagination.astro';
import Popover from '../components/(ui)/Popover.astro';
import Progress from '../components/(ui)/Progress.astro';
import Range from '../components/(ui)/Range.astro';
import Switch from '../components/(ui)/Switch.astro';
import Tabs from '../components/(ui)/Tabs.astro';
import Text from '../components/(ui)/Text.astro';
import Title from '../components/(ui)/Title.astro';
import Toast from '../components/(ui)/Toast.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
---

<Layout>
    <Header slot="head" class="grid grid-cols-container">
        <nav class="flex justify-center py-4 gap-4">
            <a class="x-text link" href="#">Home</a>
            <a class="x-text link" href="#">About</a>
        </nav>
    </Header>

    <div class="grid grid-cols-container py-12">
        <div class="flex flex-col gap-8">
            <Heading as="h1" class="lg">Newlogic UI</Heading>
            <Title>Title</Title>
            <Text>Text component with <a href="#">a link</a>.</Text>
            <Info>Info text</Info>
            <Notice>Notice text</Notice>
            <Badge>Badge</Badge>

            <div class="flex gap-4">
                <Button>Button</Button>
                <Button as="a" href="#" class="bordered">Link button</Button>
                <Button class="muted sm">Small</Button>
            </div>

            <Group>
                <Control class="grow">
                    <input type="tel" placeholder="777 666 555">
                </Control>
                <Button>Send</Button>
            </Group>

            <Form method="post" action="#">
                <Field>
                    <Label for="email">Email</Label>
                    <Control>
                        <input type="email" id="email" name="email" required>
                    </Control>
                    <Info hidden>Invalid email</Info>
                </Field>
                <Check>
                    <input type="checkbox" id="check" required>
                    <label for="check">Checkbox</label>
                </Check>
                <Switch as="label">
                    <input type="checkbox">
                </Switch>
                <Button type="submit">Submit</Button>
            </Form>

            <Details>
                <summary class="x-heading sm">Accordion title</summary>
                <Text class="pt-6">Accordion content</Text>
            </Details>

            <Progress value="40" max="100" />

            <Marquee class="flex gap-(--x-marquee-gap) overflow-clip" style="--x-marquee-gap: calc(var(--spacing) * 6)">
                <div class="shrink-0">One</div>
                <div class="shrink-0">Two</div>
            </Marquee>

            <Image class="before:skeleton">
                <img src="https://picsum.photos/id/1005/960/540" alt="Image" width="960" height="540" loading="lazy">
            </Image>

            <Carousel class="group/carousel block" id="defaultCarousel" role="region" aria-roledescription="carousel" aria-label="Carousel gallery">
                <div class="x-carousel-content flex gap-6" tabindex="-1" data-x-carousel-part="content">
                    <img class="aspect-3/2 rounded-2xl max-w-full md:max-w-[calc(50%-0.75rem)]" src="https://placehold.co/420x280" alt=" " width="420" height="280" loading="lazy" data-snapped>
                    <img class="aspect-3/2 rounded-2xl max-w-full md:max-w-[calc(50%-0.75rem)]" src="https://placehold.co/420x280" alt=" " width="420" height="280" loading="lazy">
                </div>
                <div class="flex gap-4 justify-end mt-6">
                    <Button class="square" type="button" data-x-carousel-part="prev" command="--scrollPrev" commandfor="defaultCarousel" aria-label="Previous" disabled>←</Button>
                    <Button class="square" type="button" data-x-carousel-part="next" command="--scrollNext" commandfor="defaultCarousel" aria-label="Next">→</Button>
                </div>
            </Carousel>

            <Tabs id="tabsElement">
                <div class="x-tabs-list" role="tablist">
                    <Button class="accent-main aria-selected:accent-primary" command="--toggle" commandfor="tabsElement" data-x-tabs-part="tab" role="tab" aria-controls="tab-all" id="all" aria-selected="true">All</Button>
                    <Button class="accent-main aria-selected:accent-primary" command="--toggle" commandfor="tabsElement" data-x-tabs-part="tab" role="tab" aria-controls="tab-photos" id="photos">Photos</Button>
                </div>
                <div class="aria-hidden:hidden" data-x-tabs-part="tabpanel" role="tabpanel" aria-hidden="false" id="tab-all" aria-labelledby="all">All</div>
                <div class="aria-hidden:hidden" data-x-tabs-part="tabpanel" role="tabpanel" aria-hidden="true" id="tab-photos" aria-labelledby="photos">Photos</div>
            </Tabs>

            <div class="flex justify-between items-center">
                <output class="x-title sm" id="from" aria-label="Cena od">0</output>
                <output class="x-title sm" id="to" aria-label="Cena do">10000</output>
            </div>
            <Range class="items-center">
                <input type="range" value="0" step="100" max="10000" min="0" aria-labelledby="from" data-x-range-part="start" data-track="start">
                <input type="range" value="10000" step="100" max="10000" min="0" aria-labelledby="to" data-x-range-part="end" data-track="end">
            </Range>

            <Pagination class="flex gap-2" aria-label="Pagination">
                <Button as="a" href="#" class="square sm" aria-current="page">1</Button>
                <Button as="a" href="#" class="square sm muted">2</Button>
            </Pagination>

            <div class="flex gap-4">
                <Button command="show-modal" commandfor="defaultDialog">Open dialog</Button>
                <Button command="show-modal" commandfor="defaultDrawer">Open drawer</Button>
                <Button command="toggle-popover" commandfor="popoverElement" aria-controls="popoverElement">Toggle popover</Button>
            </div>

            <Popover id="popoverElement" class="bottom my-2 w-(--anchor-size,anchor-size(inline))" popover="auto">
                <div class="x-popover-content shadow flex flex-col p-2 w-40">
                    <Button class="ghosted accent-main justify-start">Item 1</Button>
                    <Button class="ghosted accent-main justify-start">Item 2</Button>
                </div>
            </Popover>
        </div>
    </div>

    <Fragment slot="foot">
        <Footer />

        <Dialog id="defaultDialog" closedby="any">
            <div class="x-dialog-content max-w-md p-6">
                <Heading class="sm mb-4">Dialog</Heading>
                <Text>Dialog content</Text>
                <Button class="muted mt-6" command="close" commandfor="defaultDialog">Close</Button>
            </div>
        </Dialog>

        <Drawer id="defaultDrawer" closedby="any">
            <div class="x-drawer-scroller snap-x snap-mandatory">
                <nav class="x-drawer-content" data-x-drawer-part="content">
                    Drawer content
                    <Button class="muted" command="request-close" commandfor="defaultDrawer">Close</Button>
                </nav>
            </div>
        </Drawer>
    </Fragment>

    <Toast slot="toast" id="toastElement">
        <div class="x-toast-content">
            <div class="flex-col">
                <Title>Hello toast</Title>
                <Text>Amazing toast</Text>
            </div>
            <Button class="muted ml-auto" command="--close" commandfor="toastElement">Close</Button>
        </div>
    </Toast>
</Layout>
